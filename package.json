{
  "name": "composition",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@composition/builder",
    "dev:lean": "turbo run dev --filter=@composition/builder --cache=local:r",
    "dev:kill": "for port in ${DEV_PORTS:-5173}; do lsof -ti :$port 2>/dev/null | xargs kill -9 2>/dev/null; done; echo \"Dev servers killed: ${DEV_PORTS:-5173}\"",
    "build": "turbo run build",
    "build:all": "turbo run build:all",
    "build:specs": "pnpm generate:palette && pnpm generate:css",
    "dev:specs": "pnpm -F @composition/rendering exec tsc --noEmit --watch",
    "gate:catalog-errors": "node apps/builder/scripts/catalog-error-sweep.mjs",
    "docs:stale-symbols": "python3 -I scripts/check-stale-doc-symbols.py",
    "cache:clean": "rm -rf .turbo/cache",
    "generate:css": "pnpm -F @composition/rendering generate:css",
    "generate:palette": "pnpm -F @composition/rendering generate:palette",
    "validate:sync": "pnpm -F @composition/rendering validate:sync",
    "type-check": "turbo run type-check",
    "test:registration-contract": "pnpm -F @composition/builder exec vitest run src/builder/catalogRuntime/__tests__/phase4ePalette.test.ts src/builder/catalogRuntime/__tests__/phase3G3Census.test.tsx",
    "codex:guard": "bash scripts/codex/protect-files.sh",
    "codex:format": "bash scripts/codex/format-changed.sh",
    "codex:format:check": "bash scripts/codex/format-changed.sh --check",
    "codex:typecheck": "bash scripts/codex/type-check-gate.sh",
    "codex:registration": "bash scripts/codex/registration-gate.sh",
    "codex:preflight": "pnpm run codex:guard && pnpm run codex:format:check && pnpm run codex:typecheck && pnpm run codex:registration && pnpm run codex:agent-catalog && pnpm run codex:skills:gate",
    "codex:harness": "bash scripts/codex/harness.sh",
    "codex:route": "bash scripts/codex/route-prompt.sh",
    "codex:snapshot": "bash scripts/codex/context-snapshot.sh",
    "codex:agent-catalog": "bash scripts/codex/agent-catalog-gate.sh",
    "claude:hooks:selftest": "bash .claude/hooks/selftest.sh",
    "codex:hooks:selftest": "bash scripts/codex/hook-selftest.sh",
    "hooks:selftest": "pnpm run claude:hooks:selftest && pnpm run codex:hooks:selftest",
    "agent:run": "bash scripts/agent/run-ledger.sh",
    "agent:work": "bash scripts/agent/work.sh",
    "agent:dashboard": "bash scripts/agent/dashboard.sh",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "playwright:install": "pnpm -F @composition/builder exec playwright install",
    "wasm:build:engine": "wasm-pack build packages/engine --target bundler --out-dir ../../apps/builder/src/builder/workspace/canvas/wasm-bindings/engine-pkg",
    "prepare:specs": "pnpm -F @composition/rendering generate:icons && pnpm run build:specs",
    "prepare:upload": "pnpm -F @composition/upload build",
    "postinstall": "pnpm run prepare:specs && pnpm run prepare:upload",
    "codex:session-start": "bash scripts/codex/session-start.sh",
    "gate:install": "bash scripts/install-git-hooks.sh",
    "gate:perf-ratchet": "node apps/builder/scripts/perf-ratchet-gate.mjs --run",
    "perf:adr248-followup": "node apps/builder/scripts/adr248-structural-actionbar-perf.mjs",
    "perf:baseline": "node apps/builder/scripts/perf-baseline.mjs",
    "gate:catalog-runtime": "pnpm -F @composition/builder exec node scripts/adr248-runtime-boundary.mjs",
    "codex:skills:validate": "node scripts/codex/validate-skills.mjs",
    "codex:skills:test": "node --test scripts/codex/skills.test.mjs",
    "codex:skills:gate": "bash scripts/codex/skills-gate.sh",
    "codex:workflow:test": "node --test .codex/tests/*.test.mjs"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11"
  },
  "packageManager": "pnpm@10.26.2",
  "pnpm": {
    "patchedDependencies": {
      "react-aria@3.52.0": "patches/react-aria@3.52.0.patch",
      "react-dom@19.2.8": "patches/react-dom@19.2.8.patch"
    }
  }
}
