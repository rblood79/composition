{
  "name": "composition",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run build --filter=...^@composition/builder && pnpm -F @composition/builder dev",
    "dev:kill": "for port in 5173 5174 5175 5176 5177; do lsof -ti :$port 2>/dev/null | xargs kill -9 2>/dev/null; done; echo 'Dev servers killed'",
    "build": "turbo run build",
    "build:preview": "turbo run build:preview",
    "build:all": "turbo run build:all",
    "build:specs": "pnpm -F @composition/specs build",
    "dev:specs": "pnpm -F @composition/specs dev",
    "generate:css": "pnpm -F @composition/specs generate:css",
    "generate:palette": "pnpm -F @composition/specs generate:palette",
    "validate:sync": "pnpm -F @composition/specs validate:sync",
    "type-check": "turbo run type-check",
    "test:registration-contract": "pnpm -F @composition/builder exec vitest run src/builder/factories/__tests__/componentRegistrationContract.test.ts",
    "codex:guard": "bash scripts/codex/protect-files.sh",
    "codex:format": "bash scripts/codex/format-changed.sh",
    "codex:typecheck": "bash scripts/codex/type-check-gate.sh",
    "codex:registration": "bash scripts/codex/registration-gate.sh",
    "codex:preflight": "pnpm run codex:guard && pnpm run codex:format && pnpm run codex:typecheck && pnpm run codex:registration",
    "codex:harness": "bash scripts/codex/harness.sh",
    "codex:route": "bash scripts/codex/route-prompt.sh",
    "codex:snapshot": "bash scripts/codex/context-snapshot.sh",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "pnpm -F @composition/specs test:coverage",
    "clean": "turbo run clean && rm -rf node_modules",
    "playwright:install": "npx playwright install",
    "test:e2e": "playwright test",
    "wasm:build:engine": "wasm-pack build packages/composition-engine --target bundler --out-dir ../../apps/builder/src/builder/workspace/canvas/wasm-bindings/composition-engine-pkg",
    "prepare:wasm": "node scripts/prepare-wasm.mjs",
    "prepare:specs": "node packages/specs/scripts/extract-lucide-icons.mjs && pnpm run build:specs",
    "postinstall": "pnpm run prepare:wasm && pnpm run prepare:specs",
    "codex:session-start": "bash scripts/codex/session-start.sh"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.79",
    "@playwright/test": "^1.62.1",
    "gray-matter": "^4.0.3",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.26.2",
  "pnpm": {
    "patchedDependencies": {
      "react-aria@3.51.0": "patches/react-aria@3.51.0.patch"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "jszip": "^3.10.1",
    "quill": "^2.0.3"
  }
}
