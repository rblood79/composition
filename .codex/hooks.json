{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/admin/work/composition/.codex/hooks/protect-files.sh'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/admin/work/composition/.codex/hooks/spec-rebuild-flag.sh'"
          },
          {
            "type": "command",
            "command": "'/Users/admin/work/composition/.codex/hooks/auto-format.sh'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/admin/work/composition/.codex/hooks/session-start.sh'"
          },
          {
            "type": "command",
            "command": "CLAUDE_PROJECT_DIR='/Users/admin/work/composition' '/Users/admin/work/composition/.claude/hooks/fix-visibility.sh'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/admin/work/composition/.codex/hooks/route-prompt.sh'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/admin/work/composition/.codex/hooks/type-check-gate.sh'",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "CLAUDE_PROJECT_DIR='/Users/admin/work/composition' '/Users/admin/work/composition/.claude/hooks/fix-visibility.sh'",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
