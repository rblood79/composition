# ============================================
# Feature Flags
# ============================================

# WebGL Canvas (CanvasKit/Skia) 활성화
# false 시 iframe 기반 Preview로 폴백
VITE_USE_WEBGL_CANVAS=true

# 디버그 로그 출력 (콘솔)
VITE_ENABLE_DEBUG_LOGS=false

# 캔버스 비교 모드 — iframe + WebGL 캔버스를 동시 표시하여 교차검증
VITE_CANVAS_COMPARE_MODE=false

# 히트 영역 디버그 시각화 — 투명 히트 영역을 빨간색 반투명으로 표시
VITE_ENABLE_HITAREA_MODE=false

# ============================================
# License — 폐쇄망 인증, 서버 없음 (설정 불필요)
# ============================================

# 발급기 공개키는 소스에 내장 (src/auth/license/issuerPublicKey.ts). 배포별로 다른 발급기 키를 쓸 때만 override:
# VITE_LICENSE_PUBLIC_KEY=<발급기 keys/public_key 내용 — 헤더 포함/제외 무관>

# 사용 절차: 발급기 HTML 에서 생성 → zip 의 `license` 파일을 apps/builder/public/license (gitignore) 로 복사 → 로그인 화면에 검증 코드 입력.

# ============================================
# AI Provider API Keys
# ============================================

# Anthropic — Claude 모델
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Perplexity (Optional)
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# OpenAI / OpenRouter (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (Optional)
GOOGLE_API_KEY=your_google_api_key_here

# Mistral AI (Optional)
MISTRAL_API_KEY=your_mistral_api_key_here

# xAI (Optional)
XAI_API_KEY=your_xai_api_key_here

# Azure OpenAI (Optional, endpoint는 .taskmasterconfig에서 설정)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# ============================================
# External Services (Optional)
# ============================================

# Figma API — 테마/디자인 토큰 가져오기
VITE_FIGMA_ACCESS_TOKEN=your_figma_access_token_here
