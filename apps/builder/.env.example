# ============================================
# Feature Flags
# ============================================

# WebGL Canvas (CanvasKit/Skia) 활성화
# false 시 iframe 기반 Preview로 폴백
VITE_USE_WEBGL_CANVAS=true

# 디버그 로그 출력 (콘솔)
VITE_ENABLE_DEBUG_LOGS=false

# 캔버스 비교 모드 — iframe + WebGL 캔버스를 동시 표시하여 교차검증
VITE_CANVAS_COMPARE_MODE=false

# 히트 영역 디버그 시각화 — 투명 히트 영역을 빨간색 반투명으로 표시
VITE_ENABLE_HITAREA_MODE=false

# ============================================
# License (Required) — 폐쇄망 인증, 서버 없음
# ============================================

# 발급기 공개키 (PEM). 발급기: /Users/admin/work/jwt → `python3 main.py keygen` 의 `public_key` 파일 내용.
# 헤더 포함 여부·개행 무관 (base64 본문 한 줄이면 충분).
VITE_LICENSE_PUBLIC_KEY=MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE...

# 토큰 파일은 서버 루트 `license.jwt` (apps/builder/public/license.jwt, gitignore) 에 배포하면 자동 인식,
# 없으면 로그인 화면에서 파일 선택. 검증 코드 6자리는 토큰과 다른 채널로 전달.

# ============================================
# AI Provider API Keys
# ============================================

# Anthropic — Claude 모델
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Perplexity (Optional)
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# OpenAI / OpenRouter (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (Optional)
GOOGLE_API_KEY=your_google_api_key_here

# Mistral AI (Optional)
MISTRAL_API_KEY=your_mistral_api_key_here

# xAI (Optional)
XAI_API_KEY=your_xai_api_key_here

# Azure OpenAI (Optional, endpoint는 .taskmasterconfig에서 설정)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# ============================================
# External Services (Optional)
# ============================================

# Figma API — 테마/디자인 토큰 가져오기
VITE_FIGMA_ACCESS_TOKEN=your_figma_access_token_here
