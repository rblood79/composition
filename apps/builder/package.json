{
  "name": "@composition/builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preview": "vite build --config vite.preview.config.ts",
    "build:all": "pnpm run build:preview && pnpm run build",
    "lint": "eslint src/",
    "preview": "vite preview",
    "type-check": "bash scripts/type-check-baseline.sh",
    "type-check:raw": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "type-check:strict": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "vitest run --config vitest.browser.config.ts",
    "test:visual-parity": "vitest run --config vitest.visual-parity.config.ts",
    "clean": "rm -rf dist node_modules/.vite",
    "test:visual-parity:smoke": "node scripts/visual-parity-gate.mjs smoke",
    "test:visual-parity:full": "node scripts/visual-parity-gate.mjs full"
  },
  "dependencies": {
    "@composition/publish": "workspace:*",
    "@composition/shared": "workspace:*",
    "@composition/specs": "workspace:*",
    "@internationalized/date": "^3.12.4",
    "@internationalized/number": "^3.6.8",
    "@react-aria/focus": "^3.22.1",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/utils": "^3.34.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.5.4",
    "canvaskit-wasm": "^0.42.0",
    "clsx": "^2.1.1",
    "colord": "^2.10.0",
    "fuse.js": "^7.5.0",
    "hellpeq": "^1.0.1",
    "immer": "catalog:",
    "intervaq": "^2.1.2",
    "lodash": "^4.18.1",
    "lucide-react": "^1.33.0",
    "nanoid": "^5.1.16",
    "papaparse": "^5.6.0",
    "postcss": "^8.5.26",
    "pretendard": "^1.3.9",
    "quill": "^2.0.3",
    "react": "catalog:",
    "react-aria": "^3.52.0",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "react-stately": "^3.50.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-react-aria-components": "^2.2.0",
    "three": "^0.185.1",
    "uuid": "^14.0.2",
    "web-vitals": "^6.2.1",
    "zod": "^4.4.3",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@composition/config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/lodash": "^4.17.25",
    "@types/node": "catalog:",
    "@types/papaparse": "^5.5.2",
    "pixelmatch": "^7.2.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.8.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "puppeteer": "^25.8.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "catalog:"
  }
}
