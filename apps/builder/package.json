{
  "name": "@composition/builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preview": "vite build --config vite.preview.config.ts",
    "build:all": "pnpm run build:preview && pnpm run build",
    "lint": "eslint src/",
    "preview": "vite preview",
    "type-check": "bash scripts/type-check-baseline.sh",
    "type-check:raw": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "type-check:strict": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:pixi-plan": "node scripts/check-pixi-component-plan.mjs",
    "fix:pixi-plan": "node scripts/check-pixi-component-plan.mjs --write",
    "wasm:build": "wasm-pack build src/builder/workspace/canvas/wasm --target bundler --out-dir ../../../../../wasm-bindings/pkg",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "@composition/publish": "workspace:*",
    "@composition/shared": "workspace:*",
    "@composition/specs": "workspace:*",
    "@internationalized/date": "^3.12.2",
    "@internationalized/number": "^3.6.7",
    "@material/material-color-utilities": "^0.4.0",
    "@react-aria/focus": "^3.22.1",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/utils": "^3.34.1",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.26",
    "@types/three": "^0.183.1",
    "autoprefixer": "^10.5.0",
    "canvaskit-wasm": "^0.40.0",
    "clsx": "^2.1.1",
    "colord": "^2.9.3",
    "fuse.js": "^7.3.0",
    "groq-sdk": "^0.37.0",
    "hellpeq": "^1.0.1",
    "immer": "catalog:",
    "intervaq": "^2.1.2",
    "lodash": "^4.18.1",
    "lucide-react": "^0.575.0",
    "nanoid": "^5.1.11",
    "papaparse": "^5.5.3",
    "postcss": "^8.5.15",
    "pretendard": "^1.3.9",
    "quill": "^2.0.3",
    "react": "catalog:",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "react-router-dom": "catalog:",
    "react-stately": "^3.47.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-react-aria-components": "^2.1.1",
    "three": "^0.183.2",
    "uuid": "^13.0.2",
    "zod": "^4.4.3",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@composition/config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/lodash": "^4.17.24",
    "@types/node": "catalog:",
    "@types/papaparse": "^5.5.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react-swc": "catalog:",
    "@vitest/browser": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "puppeteer": "^24.43.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.7"
  }
}
