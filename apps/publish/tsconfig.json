{
  "extends": "@composition/config/tsconfig/react-app",
  "compilerOptions": {
    "paths": {
      "@composition/shared": ["../../packages/shared/src"],
      "@composition/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*", "../../packages/shared/src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "../../packages/shared/src/**/*.test.ts",
    "../../packages/shared/src/**/*.test.tsx"
  ]
}
