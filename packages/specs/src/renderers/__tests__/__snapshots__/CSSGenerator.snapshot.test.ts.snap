  }

  .react-aria-Slider[data-size="xl"] .react-aria-Label {
    font-size: var(--text-lg);
  }

  .react-aria-Slider[data-size="xl"] .react-aria-SliderOutput {
    font-size: var(--text-lg);
  }


  .react-aria-Slider[data-size="sm"] .slider-track-bg { height: 4px; }
  .react-aria-Slider[data-size="sm"] .slider-fill { height: 4px; }
  .react-aria-Slider[data-size="sm"] .react-aria-SliderThumb { width: 14px; height: 14px; }

  .react-aria-Slider[data-size="md"] .slider-track-bg { height: 8px; }
  .react-aria-Slider[data-size="md"] .slider-fill { height: 8px; }
  .react-aria-Slider[data-size="md"] .react-aria-SliderThumb { width: 18px; height: 18px; }

  .react-aria-Slider[data-size="lg"] .slider-track-bg { height: 12px; }
  .react-aria-Slider[data-size="lg"] .slider-fill { height: 12px; }
  .react-aria-Slider[data-size="lg"] .react-aria-SliderThumb { width: 22px; height: 22px; }

  .react-aria-Slider[data-size="xl"] .slider-track-bg { height: 16px; }
  .react-aria-Slider[data-size="xl"] .slider-fill { height: 16px; }
  .react-aria-Slider[data-size="xl"] .react-aria-SliderThumb { width: 26px; height: 26px; }


} /* @layer components */"
`;

exports[`CSSGenerator snapshot baseline > Slot 1`] = `
