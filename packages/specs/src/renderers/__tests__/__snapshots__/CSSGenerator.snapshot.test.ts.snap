exports[`CSSGenerator snapshot baseline > Slider 1`] = `
"/* ============================================================
 * AUTO-GENERATED from SliderSpec — DO NOT EDIT MANUALLY
 * Source: packages/specs/src/components/Slider.spec.ts
 * Archetype: slider
 * ============================================================ */

@layer components {

.react-aria-Slider {
  /* Base styles — archetype: slider */
    display: grid;
    grid-template-areas: "label output" "track track";
    grid-template-columns: 1fr auto;
    box-sizing: border-box;

    .react-aria-Label { grid-area: label; }
    .react-aria-SliderOutput { grid-area: output; justify-self: end; }
    .react-aria-SliderTrack {
      grid-area: track;
      position: relative;
      display: flex;
      align-items: center;
    }
    .slider-track-bg {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 100%;
      border-radius: var(--radius-full);
      background: var(--bg-muted);
    }
    .slider-fill {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      border-radius: var(--radius-full);
      background: var(--accent);
    }
    .react-aria-SliderThumb {
      top: 50%;
      border-radius: var(--radius-full);
      background: var(--accent);
      border: 2px solid var(--bg);
      box-sizing: border-box;
    }

  /* Container styles (ADR-071 + ADR-083 Phase 1) */
  display: grid;
  grid-template-areas: "label output" "track track";
  grid-template-columns: 1fr auto;

  /* Default size */
  padding: 0px 0px;
  font-size: var(--text-sm);
  border-radius: var(--radius-full);
  line-height: var(--text-sm--line-height);
  gap: 4px;
  column-gap: 16px;
}

.react-aria-Slider[data-size="sm"] {
  padding: 0px 0px;
  font-size: var(--text-xs);
  border-radius: var(--radius-full);
  line-height: var(--text-xs--line-height);
  gap: 4px;
  column-gap: 16px;
}

.react-aria-Slider[data-size="md"] {
  padding: 0px 0px;
  font-size: var(--text-sm);
  border-radius: var(--radius-full);
  line-height: var(--text-sm--line-height);
  gap: 4px;
  column-gap: 16px;
}

.react-aria-Slider[data-size="lg"] {
  padding: 0px 0px;
  font-size: var(--text-base);
  border-radius: var(--radius-full);
  line-height: var(--text-base--line-height);
  gap: 4px;
  column-gap: 20px;
}

.react-aria-Slider[data-size="xl"] {
  padding: 0px 0px;
  font-size: var(--text-lg);
  border-radius: var(--radius-full);
  line-height: var(--text-lg--line-height);
  gap: 4px;
  column-gap: 20px;
}

.react-aria-Slider[data-hovered] {
}

.react-aria-Slider[data-focus-visible] {
  outline: var(--focus-ring-width) solid var(--focus-ring);
  outline-offset: var(--focus-ring-offset);
}

.react-aria-Slider[data-pressed] {
}

.react-aria-Slider[data-disabled] {
  opacity: 0.38;
  cursor: not-allowed;
  pointer-events: none;
}

/* ── Tier 2: Composite Delegation ── */


@media (forced-colors: active) {
  .react-aria-Slider {
    forced-color-adjust: auto;
  }
}


  .react-aria-Slider[data-size="sm"] .react-aria-Label {
    font-size: var(--text-xs);
  }

  .react-aria-Slider[data-size="sm"] .react-aria-SliderOutput {
    font-size: var(--text-xs);
  }

  .react-aria-Slider[data-size="md"] .react-aria-Label {
    font-size: var(--text-sm);
  }

  .react-aria-Slider[data-size="md"] .react-aria-SliderOutput {
    font-size: var(--text-sm);
  }

  .react-aria-Slider[data-size="lg"] .react-aria-Label {
    font-size: var(--text-base);
  }

  .react-aria-Slider[data-size="lg"] .react-aria-SliderOutput {
    font-size: var(--text-base);
  }

  .react-aria-Slider[data-size="xl"] .react-aria-Label {
    font-size: var(--text-lg);
  }

  .react-aria-Slider[data-size="xl"] .react-aria-SliderOutput {
    font-size: var(--text-lg);
  }


  .react-aria-Slider[data-size="sm"] .slider-track-bg { height: 4px; }
  .react-aria-Slider[data-size="sm"] .slider-fill { height: 4px; }
  .react-aria-Slider[data-size="sm"] .react-aria-SliderThumb { width: 14px; height: 14px; }

  .react-aria-Slider[data-size="md"] .slider-track-bg { height: 8px; }
  .react-aria-Slider[data-size="md"] .slider-fill { height: 8px; }
  .react-aria-Slider[data-size="md"] .react-aria-SliderThumb { width: 18px; height: 18px; }

  .react-aria-Slider[data-size="lg"] .slider-track-bg { height: 12px; }
  .react-aria-Slider[data-size="lg"] .slider-fill { height: 12px; }
  .react-aria-Slider[data-size="lg"] .react-aria-SliderThumb { width: 22px; height: 22px; }

  .react-aria-Slider[data-size="xl"] .slider-track-bg { height: 16px; }
  .react-aria-Slider[data-size="xl"] .slider-fill { height: 16px; }
  .react-aria-Slider[data-size="xl"] .react-aria-SliderThumb { width: 26px; height: 26px; }


} /* @layer components */"
`;

