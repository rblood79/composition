 * Archetype: alert
 * ============================================================ */

@layer components {

.react-aria-InlineAlert {
  /* Base styles — archetype: alert */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    box-sizing: border-box;
    width: 100%;
    font-family: var(--font-sans);

  /* Container styles (ADR-071 + ADR-083 Phase 1) */
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;

  /* Default variant */
  background: var(--color-info-100);
  color: var(--fg);
  border: 1px solid var(--color-info-600);

  /* Default size */
  height: auto;
  padding: 16px 16px;
  font-size: var(--text-base);
  border-radius: var(--radius-lg);
  gap: 12px;
}

.react-aria-InlineAlert[data-variant="neutral"] {
  background: var(--bg-muted);
  color: var(--fg);
  border-color: var(--fg-muted);

  &[data-hovered] {
    background: var(--bg-muted);
  }

  &[data-pressed] {
    background: var(--bg-muted);
  }
}

.react-aria-InlineAlert[data-variant="info"] {
  background: var(--color-info-100);
  color: var(--fg);
  border-color: var(--color-info-600);

  &[data-hovered] {
    background: var(--color-info-100);
  }

  &[data-pressed] {
    background: var(--color-info-100);
  }
}

.react-aria-InlineAlert[data-variant="positive"] {
  background: var(--color-green-100);
  color: var(--fg);
  border-color: var(--color-green-600);

  &[data-hovered] {
    background: var(--color-green-100);
  }

  &[data-pressed] {
    background: var(--color-green-100);
  }
}

.react-aria-InlineAlert[data-variant="notice"] {
  background: var(--color-warning-100);
  color: var(--fg);
  border-color: var(--color-warning-600);

  &[data-hovered] {
    background: var(--color-warning-100);
  }

  &[data-pressed] {
    background: var(--color-warning-100);
  }
}

.react-aria-InlineAlert[data-variant="negative"] {
  background: var(--color-error-100);
  color: var(--fg);
  border-color: var(--negative);

  &[data-hovered] {
    background: var(--color-error-100);
  }

  &[data-pressed] {
    background: var(--color-error-100);
  }
}

.react-aria-InlineAlert[data-size="sm"] {
  height: auto;
  padding: 8px 8px;
  font-size: var(--text-sm);
  border-radius: var(--radius-md);
  gap: 8px;
}

.react-aria-InlineAlert[data-size="md"] {
  height: auto;
  padding: 16px 16px;
  font-size: var(--text-base);
  border-radius: var(--radius-lg);
  gap: 12px;
}

.react-aria-InlineAlert[data-size="lg"] {
  height: auto;
  padding: 24px 24px;
  font-size: var(--text-lg);
  border-radius: var(--radius-xl);
  gap: 16px;
}

/* Heading */
.react-aria-InlineAlert .alert-heading {
  margin: 0;
  font-size: 16px;
