"/* ============================================================
 * AUTO-GENERATED from ImageSpec — DO NOT EDIT MANUALLY
 * Source: packages/specs/src/components/Image.spec.ts
 * Archetype: simple
 * ============================================================ */

@layer components {

.react-aria-Image {
  /* Base styles — archetype: simple */
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;

  /* Container styles (ADR-071 + ADR-083 Phase 1) */
  display: inline-flex;
  align-items: center;

  /* Default variant */
  background: var(--bg-muted);
  color: var(--fg-muted);
  border: none;

  /* Default size */
  height: 200px;
  padding: 0px 0px;
  font-size: var(--text-sm);
  border-radius: var(--radius-none);
}

.react-aria-Image[data-variant="default"] {
  background: var(--bg-muted);
  color: var(--fg-muted);

  &[data-hovered] {
    background: var(--bg-muted);
  }

  &[data-pressed] {
    background: var(--bg-muted);
  }
}

.react-aria-Image[data-size="sm"] {
  height: 120px;
  padding: 0px 0px;
  font-size: var(--text-xs);
  border-radius: var(--radius-none);
}

.react-aria-Image[data-size="md"] {
  height: 200px;
  padding: 0px 0px;
  font-size: var(--text-sm);
  border-radius: var(--radius-none);
}

.react-aria-Image[data-size="lg"] {
  height: 320px;
  padding: 0px 0px;
  font-size: var(--text-base);
  border-radius: var(--radius-none);
}

.react-aria-Image[data-hovered] {
}

.react-aria-Image[data-focus-visible] {
  outline: var(--focus-ring-width) solid var(--focus-ring);
  outline-offset: var(--focus-ring-offset);
}

.react-aria-Image[data-pressed] {
}

.react-aria-Image[data-disabled] {
  opacity: 0.38;
  cursor: not-allowed;
  pointer-events: none;
}

@media (forced-colors: active) {
  .react-aria-Image {
    forced-color-adjust: auto;
  }
}


} /* @layer components */"
`;

