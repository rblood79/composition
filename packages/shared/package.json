{
  "name": "@composition/shared",
  "version": "0.1.0",
  "private": true,
  "description": "composition shared types, utilities, components, and renderers",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./components/list": {
      "types": "./src/components/list.ts",
      "default": "./src/components/list.ts"
    },
    "./components/metadata": {
      "types": "./src/components/metadata.ts",
      "default": "./src/components/metadata.ts"
    },
    "./components/styles/*": {
      "default": "./src/components/styles/*"
    },
    "./renderers": {
      "types": "./src/renderers/index.ts",
      "default": "./src/renderers/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "dependencies": {
    "@composition/specs": "workspace:*",
    "@internationalized/date": "^3.12.3",
    "@internationalized/number": "^3.6.7",
    "@react-aria/focus": "^3.22.1",
    "@react-aria/utils": "^3.34.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/node": "catalog:",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.33.0",
    "react-aria-components": "catalog:",
    "react-stately": "^3.49.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@composition/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "^10.8.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.4.3"
  }
}
