{
  "name": "@composition/shared",
  "version": "0.1.0",
  "private": true,
  "description": "composition shared types, utilities, components, and renderers",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./components/list": {
      "types": "./src/components/list.ts",
      "default": "./src/components/list.ts"
    },
    "./components/metadata": {
      "types": "./src/components/metadata.ts",
      "default": "./src/components/metadata.ts"
    },
    "./components/styles/*": {
      "default": "./src/components/styles/*"
    },
    "./renderers": {
      "types": "./src/renderers/index.ts",
      "default": "./src/renderers/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./i18n": {
      "types": "./src/i18n/index.ts",
      "default": "./src/i18n/index.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "dependencies": {
    "@composition/specs": "workspace:*",
    "@internationalized/date": "catalog:",
    "@internationalized/number": "catalog:",
    "@react-aria/focus": "catalog:",
    "@react-aria/i18n": "catalog:",
    "@react-aria/utils": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "jszip": "^3.10.1",
    "lucide-react": "catalog:",
    "react-aria-components": "catalog:",
    "react-stately": "catalog:",
    "recharts": "3.10.1",
    "tailwind-merge": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@composition/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
