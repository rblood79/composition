# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local
.env*.local

# Dependencies (pnpm — npm 실수로 생기는 lock 은 추적하지 않음)
node_modules/
.pnpm-store/
.npm-cache/
package-lock.json

# Build / cache
dist/
.turbo/
.cache/
.vercel
.output
*.tsbuildinfo
/build/

# WASM — wasm-pack 산출물 (pnpm wasm:build:engine). CanvasKit wasm 은 Vite 빌드 산출물 (ADR-244)
apps/builder/src/builder/workspace/canvas/wasm-bindings/engine-pkg/
target-install/

# Tests / coverage / Playwright
test-results/
playwright-report/
blob-report/
coverage/
.playwright-cli/
/output/
# 하니스 덤프
**/.artifacts/

# Logs / temp
logs/
*.log
*.bak
*.tmp
*~

# Editors / local agent IDEs
.idea/
*.sw?
.kiro/
.windsurf/
.roo/

# Storybook
storybook-static/

# tsc -b 가 src 옆에 emit 한 산출물.
# Vite 가 .ts 대신 .js 를 우선 로드해 HMR 이 오염됨 (ADR-915, 커밋 367fe7b3b).
apps/builder/src/**/*.js
!apps/builder/src/**/*.config.js
packages/shared/src/**/*.js
packages/shared/src/**/*.js.map
packages/shared/src/**/*.d.ts
packages/shared/src/**/*.d.ts.map
!packages/shared/src/**/*.config.js
# 손수 작성 ambient 선언 (컴파일 산출물 아님)
!packages/shared/src/css-modules.d.ts

# Agent / worktree / local settings
.worktrees/
.agent/runs/
.claude/settings.local.json
.claude/.spec-rebuild-pending
.claude/.css-regen-pending
.claude/.adr-split-commit-allowed
CLAUDE.local.md
# 옛 .claude/commands 자동 이관 잔재 (정본은 .claude/skills/, 승인 삭제 후 2회 재유입)
.agents/skills/source-command-*/

# Local docs / evidence (커밋 금지)
docs/react-aria/
docs/pencil-extracted/
docs/pencil-copy/
docs/migrations/evidence/
docs/adr/evidence/
docs/design/

# License token files (local deployment only)
apps/builder/token
apps/builder/token.jwt
apps/builder/public/license
apps/builder/scripts/.auth-session*.json

# Builder harness run outputs
apps/builder/scripts/.out/
apps/builder/scripts/.tmp-panel-cap/

# 라이선스 인증 코드 (로컬 전용 — 커밋 금지)
verification_code.txt
