#!/usr/bin/env bash
# ADR-246 Phase 1 — 결정적 카운트 성능 ratchet 게이트
# (ADR-198 · 205 시각 파리티 단계는 ADR-248 Phase 4e 에서 뺐다 — 옛 Skia 경로를 재던 smoke 와
#  텍스트 축 격차표가 옛 렌더 경로와 함께 지워졌다. 사용자 결정 2026-10-02.)
#
# **기본은 끔 (2026-10-24 사용자 결정 「push 자동 실행 끄고 수동으로」)**: push 마다 seed 전체를
# 재고 넘으면 한 번 더 재는 비용이 작업 시간보다 길었고, 값이 둘로 갈리는 키 (같은 코드에서
# 63 · 64) 가 두 번 다 위쪽이 나오면 막혀 흐름이 끊겼다. 10-10 이후 상한 올림 15 커밋 ·
# 누적 raise 404 에 비해 게이트가 잡아 고친 것은 호출 수 줄이기 ~8 건이었다. 측정은 성능 작업
# 때 `pnpm gate:perf-ratchet` 로 직접 돌린다.
#
# push 에서 돌리려면 `PERF_RATCHET=1 git push origin main` — 성능 경로에 닿은 push 만 잰다
# (문서/통계/ADR 본문 · 테스트만 바뀐 push 는 그대로 통과).
#
# 구조 (ADR-246 round 1·2 리뷰): 조기 exit 0 을 두지 않는다 — 변경 목록 수집 → 스코프 판정
# → 해당 게이트 순차 실행 (실패 즉시 exit 1) → 마지막에 한 번 exit 0. 빈 변경 목록만 즉시 통과.
#
# 설치: `bash scripts/install-git-hooks.sh` (core.hooksPath 를 .githooks 로)

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# 기본 끔 — `PERF_RATCHET=1` 일 때만 돈다 (옛 탈출구 `SKIP_PERF_RATCHET=1` 은 그대로 끈다).
RUN_RATCHET=0
if [ "${PERF_RATCHET:-0}" = "1" ] && [ "${SKIP_PERF_RATCHET:-0}" != "1" ]; then
  RUN_RATCHET=1
fi

# push 되는 커밋 범위의 변경 파일 목록.
# pre-push 는 stdin 으로 "<local ref> <local sha> <remote ref> <remote sha>" 를 받는다.
ZERO="0000000000000000000000000000000000000000"
CHANGED=""
PUSH_SHA=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue # 브랜치 삭제
  [ -z "$PUSH_SHA" ] && PUSH_SHA="$local_sha"
  if [ "$remote_sha" = "$ZERO" ]; then
    # 원격에 없는 ref — 기준을 origin/main 으로 잡고, 그것도 없으면 전량 검사로 본다
    if base="$(git merge-base "$local_sha" origin/main 2>/dev/null)"; then
      RANGE="$base..$local_sha"
    else
      CHANGED="__ALL__"
      break
    fi
  else
    RANGE="$remote_sha..$local_sha"
  fi
  CHANGED="$CHANGED"$'\n'"$(git diff --name-only "$RANGE" 2>/dev/null)"
done

[ -z "${CHANGED// /}" ] && exit 0

# ADR-246 성능 경로 — builder 런타임 · shared · engine · rendering/specs · 의존성 · 하니스와 기준 자체.
# 테스트 파일만 바뀐 push 는 제외한다 (런타임 비용이 바뀌지 않는다).
PERF_PATHS='^(apps/builder/src/|packages/shared/src/|packages/engine/(src/|Cargo\.toml$)|packages/(specs|rendering)/src/|apps/builder/vite\.config\.ts$|apps/builder/package\.json$|package\.json$|pnpm-lock\.yaml$|patches/|apps/builder/scripts/perf-(baseline|ratchet-gate|ratchet-run)\.mjs$|apps/builder/perf/ratchet\.json$)'
TEST_PATHS='(\.test\.(ts|tsx|mjs)$|/__tests__/)'

PERF_MATCHED=""
if [ "$CHANGED" = "__ALL__" ]; then
  PERF_MATCHED="__ALL__"
else
  PERF_MATCHED="$(printf '%s\n' "$CHANGED" | grep -Ev "$TEST_PATHS" | grep -E "$PERF_PATHS" || true)"
fi

cd "$REPO_ROOT" || exit 1

# ── ADR-246 성능 ratchet ─────────────────────────────────────────────────────
if [ "$RUN_RATCHET" = "1" ] && [ -n "$PERF_MATCHED" ]; then
  if [ ! -f apps/builder/perf/ratchet.json ]; then
    echo "[ADR-246] ratchet.json 없음 — 성능 ratchet 게이트를 건너뛴다 (기준 미설정)."
  else
    echo "[ADR-246] 성능 경로 변경 감지 — 결정적 카운트 ratchet 을 돌린다:"
    [ "$PERF_MATCHED" != "__ALL__" ] && printf '%s\n' "$PERF_MATCHED" | head -5 | sed 's/^/    /'
    ENGINE_FLAG=""
    if [ "$PERF_MATCHED" = "__ALL__" ] || printf '%s\n' "$PERF_MATCHED" | grep -qE '^packages/engine/'; then
      ENGINE_FLAG="--engine-changed"
    fi
    if ! node apps/builder/scripts/perf-ratchet-gate.mjs --run --sha "$PUSH_SHA" $ENGINE_FLAG; then
      exit 1
    fi
  fi
fi

exit 0
